carlitos-bot.com {
    # Webhook para Google Ads Scripts -> puerto 3001
    handle /ingest/* {
        reverse_proxy openclaw:3001
    }

    # Gateway UI y assets
    handle /__openclaw__/* {
        reverse_proxy openclaw:18789
    }

    # WebSocket connections (detectar upgrade header)
    @websocket {
        header Connection *Upgrade*
        header Upgrade websocket
    }
    handle @websocket {
        reverse_proxy openclaw:18789
    }

    # Root redirect al dashboard (solo para requests HTTP normales)
    handle {
        redir https://dashboard.carlitos-bot.com/chat permanent
    }
}

dashboard.carlitos-bot.com {
    reverse_proxy openclaw:3002
}
