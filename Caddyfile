carlitos-bot.com {
    # Webhook para Google Ads Scripts -> puerto 3001
    handle /ingest/* {
        reverse_proxy openclaw:3001
    }

    # Gateway con token (para redirects desde dashboard)
    handle /__openclaw__/* {
        reverse_proxy openclaw:18789
    }
    handle /ws {
        reverse_proxy openclaw:18789
    }

    # Root redirect al dashboard
    handle {
        redir https://dashboard.carlitos-bot.com/chat permanent
    }
}

dashboard.carlitos-bot.com {
    reverse_proxy openclaw:3002
}
