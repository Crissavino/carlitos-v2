# API Keys - al menos una es requerida
ANTHROPIC_API_KEY=sk-ant-xxxxx
OPENAI_API_KEY=sk-xxxxx

# Database Server (read-only) - contiene avocode y avocodebo
DB_HOST=127.0.0.1
DB_PORT=3306
DB_READONLY_USER=openclaw_reader
DB_READONLY_PASSWORD=xxxxx

# OpenClaw Gateway (opcional - se genera automáticamente si no se especifica)
OPENCLAW_GATEWAY_TOKEN=

# Google Ads Webhook Token (para recibir datos de Google Ads Scripts)
GOOGLE_ADS_WEBHOOK_TOKEN=
