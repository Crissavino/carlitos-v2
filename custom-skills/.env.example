# =============================================================================
# CORE DATABASE (Avocode - read-only, business data)
# =============================================================================
DB_CORE_HOST=localhost
DB_CORE_PORT=3306
DB_CORE_DATABASE=avocode
DB_CORE_USER=openclaw_reader
DB_CORE_PASSWORD=your-readonly-password

# =============================================================================
# OPENCLAW INTERNAL DATABASE (dashboard, tasks, learning)
# =============================================================================
DB_OPENCLAW_HOST=localhost
DB_OPENCLAW_PORT=3306
DB_OPENCLAW_DATABASE=openclaw_internal
DB_OPENCLAW_USER=openclaw_admin
DB_OPENCLAW_PASSWORD=your-openclaw-password

# Dashboard API
DASHBOARD_PORT=3002
DASHBOARD_TOKEN=change-this-token-in-production

# Google Ads Webhook
WEBHOOK_TOKEN=your-webhook-token

# Optional
NODE_ENV=development
