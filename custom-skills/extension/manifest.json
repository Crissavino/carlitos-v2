{
  "manifest_version": 3,
  "name": "OpenClaw Browser Context",
  "version": "0.1.0",
  "description": "Read-only context provider for OpenClaw. Eyes only - no hands, no mouth.",

  "permissions": [
    "activeTab",
    "scripting"
  ],

  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://carlitos-bot.com/*",
    "https://avocode-bo.online/*",
    "https://conversie-pdf.com/*",
    "https://convierte-pdf.com/*",
    "https://device-finder.com/*",
    "https://noxtools.com/*",
    "https://github.com/crissavino/*"
  ],

  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://carlitos-bot.com/*",
        "https://avocode-bo.online/*",
        "https://conversie-pdf.com/*",
        "https://convierte-pdf.com/*",
        "https://device-finder.com/*",
        "https://noxtools.com/*",
        "https://github.com/crissavino/*"
      ],
      "js": ["content/extractor.js"],
      "run_at": "document_idle"
    }
  ],

  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    },
    "default_title": "OpenClaw Context"
  }
}
